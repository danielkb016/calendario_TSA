// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Calendar {
  id        Int      @id @default(autoincrement())
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  requiresDailyCoordination Boolean @default(false)
  isLocked  Boolean  @default(false)
  lockReason String?
  lat       Float?
  lng       Float?
  zones               Zone[]
  flights             Flight[]
  callTargets         CallTarget[]
  globalPermits       GlobalPermit[]
}

model GlobalPermit {
  id             Int      @id @default(autoincrement())
  name           String
  expirationDate DateTime
  calendarId     Int
  calendar       Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
}

model CallTarget {
  id              Int      @id @default(autoincrement())
  name            String
  requiresOpening Boolean  @default(true)
  requiresClosing Boolean  @default(true)
  contactNotes    String?
  calendarId      Int
  calendar        Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  dailyStatuses   DailyCallStatus[]
}

model DailyCallStatus {
  id           Int      @id @default(autoincrement())
  date         DateTime
  notes        String?
  callTargetId Int
  callTarget   CallTarget @relation(fields: [callTargetId], references: [id], onDelete: Cascade)
  cycles       DailyCallCycle[]

  @@unique([callTargetId, date])
}

model DailyCallCycle {
  id                Int      @id @default(autoincrement())
  opened            Boolean  @default(false)
  openedBy          String?
  openedAt          DateTime?
  closed            Boolean  @default(false)
  closedBy          String?
  closedAt          DateTime?
  dailyCallStatusId Int
  dailyCallStatus   DailyCallStatus @relation(fields: [dailyCallStatusId], references: [id], onDelete: Cascade)
}

model Operator {
  id         Int      @id @default(autoincrement())
  name       String
}

model Zone {
  id         Int      @id @default(autoincrement())
  name       String
  calendarId Int
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  flights    Flight[]
}

model Flight {
  id             Int      @id @default(autoincrement())
  operator       String
  startDate      DateTime
  endDate        DateTime
  coordination   String   // Confirmado, Pendiente, Anulada, etc.
  situation      String?
  calendarId     Int
  calendar       Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  zoneId         Int
  zone           Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
}

model ExternalWebLink {
  id        Int      @id @default(autoincrement())
  title     String
  url       String
  imageUrl  String?
  createdAt DateTime @default(now())
}
